{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TNA-copy_assets_to_bin",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "${workspaceFolder}\\build\\copy-assets.bat"],
      "problemMatcher": []
    },
    {
      "label": "TNA-Desktop_compile_copy_assets",
      "dependsOn": [
        "ActionScript: compile debug - asconfig.json",
        "TNA-copy_assets_to_bin"
      ],
      "problemMatcher": []
    },
    {
      "label": "TNA-Android_install_and_run",
      "type": "shell",
      "dependsOn": [
        "TNA-copy_assets_to_bin",
        "Adobe AIR: package Android release - asconfig.json"
        // "Adobe AIR: package Android debug - asconfig.json"
      ],
      "command": "cmd",
      "args": [
        "/c",
        "adb shell am force-stop com.gimbalgames.veilpainter & adb install -r \"${workspaceFolder}\\bin\\VeilPainter.apk\" & adb shell am start -n com.gimbalgames.veilpainter/.AIRAppEntry"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "TNA-Package_aab",
      "dependsOn": [
        "Adobe AIR: package Android release - asconfig.json"
      ],
      "options": {
        "env": {
          "CreateAndroidAppBundle": "true"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "TNA-Package_aab_ADT",
      "type": "shell",
      "dependsOn": [
        "TNA-copy_assets_to_bin",
        "Adobe AIR: package Android release - asconfig.json"
      ],
      "command": "D:\\_sdks\\air_sdks\\AIRSDK_51.2.2\\bin\\adt.bat",
      "args": [
        "-package",
        "-target",
        "aab",
        "-storetype",
        "pkcs12",
        "-keystore",
        "${workspaceFolder}\\certs\\debug_cert.p12",
        "-storepass",
        "password",
        "${workspaceFolder}\\bin\\VeilPainter.aab",
        "${workspaceFolder}\\VeilPainter-android.xml",
        "-C",
        "${workspaceFolder}\\bin",
        "."
      ],
      "problemMatcher": []
    }
  ]
}